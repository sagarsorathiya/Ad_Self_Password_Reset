# ============================================
# AD Self-Service Password Reset Portal
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
# Bind address; use 127.0.0.1 behind IIS/nginx so the Node port is not reachable from the network
HOST=
NODE_ENV=development

# --- Network (intranet) ---
# Native HTTPS: either PEM cert+key or a PFX exported from your internal CA (leave empty for HTTP / reverse proxy)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=
# Set when behind IIS/nginx so rate limiting and audit use the real client IP (e.g. 1, loopback, or the proxy's IP)
TRUST_PROXY=false
# Comma-separated origins allowed for cross-origin calls; leave empty (same-origin only)
CORS_ORIGIN=

# --- Active Directory (LDAP/LDAPS) ---
AD_URL=ldaps://your-dc.domain.com:636
# Alternative when only port 389 is open: AD_URL=ldap://your-dc.domain.com:389 with AD_STARTTLS=true
AD_STARTTLS=false
# PEM of the internal root CA that issued the DC certificate (export with: node scripts/export-ad-ca.js)
AD_CA_CERT_PATH=
# DC hostname on its certificate, only needed if AD_URL uses an IP address
AD_TLS_SERVERNAME=
AD_BASE_DN=DC=domain,DC=com
AD_BIND_DN=CN=svc-pwdreset,OU=Service Accounts,DC=domain,DC=com
AD_BIND_PASSWORD=your-service-account-password
AD_USER_SEARCH_BASE=OU=Users,DC=domain,DC=com
AD_ADMIN_GROUP=CN=PasswordResetAdmins,OU=Groups,DC=domain,DC=com
# Use the built-in in-memory directory instead of a real DC (development/test only; refused in production)
AD_MOCK=false
# Name of this domain in user messages, e.g. Desktop (only matters when a second domain is set)
AD_DOMAIN_LABEL=

# --- Optional second domain (password sync) ---
# When AD2_URL or AD2_SERVER is set, every password change and reset is also written to this domain
# (same sAMAccountName). Sign-in and admin rights always use the first domain.
#   AD2_MODE=ldap     LDAPS/StartTLS with certificate checking (AD2_URL, AD2_CA_CERT_PATH, ...)
#   AD2_MODE=windows  Windows ADSI with Kerberos/NTLM sign-and-seal on 389, no certificate (Windows only):
#                     AD2_SERVER = writable DC hostname, AD2_BIND_DN = DOMAIN\user or user@domain,
#                     AD2_USER_SEARCH_BASE optional (empty = whole domain)
AD2_MODE=ldap
AD2_SERVER=
AD2_URL=
AD2_STARTTLS=false
AD2_CA_CERT_PATH=
AD2_TLS_SERVERNAME=
AD2_BIND_DN=
AD2_BIND_PASSWORD=
AD2_USER_SEARCH_BASE=
AD2_DOMAIN_LABEL=Secondary domain

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ad_password_reset
PG_USER=portal_user
PG_PASSWORD=your-db-password
# Encrypt the DB connection (recommended when PostgreSQL is on another host)
PG_SSL=false
PG_SSL_CA_PATH=
# Integration tests use this database (default: <PG_DATABASE>_test). Must end in _test.
# PG_TEST_DATABASE=ad_password_reset_test

# --- JWT ---
JWT_SECRET=replace-with-a-strong-random-string-at-least-64-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- TOTP ---
TOTP_ENCRYPTION_KEY=replace-with-64-char-hex-string-for-aes-256
TOTP_ISSUER=YourCompany Password Reset

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
RATE_LIMIT_GENERAL_MAX=100

# --- Password reset policy ---
# both = security questions AND authenticator (recommended) | totp_only | either
RESET_POLICY=both

# --- Mail (security alerts and password expiry reminders) ---
# Empty SMTP_HOST = no mail is sent. With SMTP_HOST set, every password change and reset sends an alert
# (time, IP, browser) to the user's AD "mail" address.
SMTP_HOST=
SMTP_PORT=25
# true = implicit TLS (port 465); otherwise STARTTLS is used whenever the server offers it
SMTP_SECURE=false
# Only if the relay requires a login (SMTP_PASSWORD can be DPAPI-encrypted)
SMTP_USER=
SMTP_PASSWORD=
# PEM of the CA that issued the mail server certificate; false only for a relay with a self-signed certificate
SMTP_CA_CERT_PATH=
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM=IT Service Desk <it-noreply@corp.example>
# Name and address shown in the mails (PORTAL_NAME defaults to TOTP_ISSUER)
PORTAL_NAME=
PORTAL_URL=https://password.corp.example
# Mail settings below are defaults only: Admin -> Mail & Reminders overrides them once saved there.
# Daily expiry reminders to every enabled AD user with a mail address (uses AD's computed expiry date)
PASSWORD_REMINDERS=false
# One reminder 14 days before expiry, then one every day over the last week
PASSWORD_REMINDER_DAYS=14,7,6,5,4,3,2,1
PASSWORD_REMINDER_HOUR=9
# Domain whose expiry is used: primary, or secondary when only the AD2 domain expires passwords. Reminders always
# go to the first-domain mail address, and only to users with an enabled first-domain account.
PASSWORD_REMINDER_SOURCE=primary

# --- Hardening ---
# Optional HTTP port that only redirects to HTTPS (e.g. 80 when PORT=443)
HTTP_REDIRECT_PORT=
# Production refuses a privileged AD_BIND_DN (Domain Admins etc.); set true only as a temporary exception
AD_ALLOW_PRIVILEGED_BIND=false
# Same for AD2_BIND_DN only; when unset, AD_ALLOW_PRIVILEGED_BIND applies to both domains
AD2_ALLOW_PRIVILEGED_BIND=

# Secrets (AD_BIND_PASSWORD, AD2_BIND_PASSWORD, PG_PASSWORD, JWT_SECRET, TOTP_ENCRYPTION_KEY, TLS_PFX_PASSPHRASE, SMTP_PASSWORD)
# can be DPAPI-encrypted: run .\scripts\protect-secret.ps1 (values become dpapi:...)
