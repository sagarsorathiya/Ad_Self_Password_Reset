# ============================================
# AD Self-Service Password Reset Portal
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
# Bind address; use 127.0.0.1 behind IIS/nginx so the Node port is not reachable from the network
HOST=
NODE_ENV=development

# --- Network (intranet) ---
# Native HTTPS: either PEM cert+key or a PFX exported from your internal CA (leave empty for HTTP / reverse proxy)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=
# Set when behind IIS/nginx so rate limiting and audit use the real client IP (e.g. 1, loopback, or the proxy's IP)
TRUST_PROXY=false
# Comma-separated origins allowed for cross-origin calls; leave empty (same-origin only)
CORS_ORIGIN=

# --- Active Directory (LDAP/LDAPS) ---
AD_URL=ldaps://your-dc.domain.com:636
# Alternative when only port 389 is open: AD_URL=ldap://your-dc.domain.com:389 with AD_STARTTLS=true
AD_STARTTLS=false
# PEM of the internal root CA that issued the DC certificate (export with: node scripts/export-ad-ca.js)
AD_CA_CERT_PATH=
# DC hostname on its certificate, only needed if AD_URL uses an IP address
AD_TLS_SERVERNAME=
AD_BASE_DN=DC=domain,DC=com
AD_BIND_DN=CN=svc-pwdreset,OU=Service Accounts,DC=domain,DC=com
AD_BIND_PASSWORD=your-service-account-password
AD_USER_SEARCH_BASE=OU=Users,DC=domain,DC=com
AD_ADMIN_GROUP=CN=PasswordResetAdmins,OU=Groups,DC=domain,DC=com
# Use the built-in in-memory directory instead of a real DC (development/test only; refused in production)
AD_MOCK=false

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ad_password_reset
PG_USER=portal_user
PG_PASSWORD=your-db-password
# Encrypt the DB connection (recommended when PostgreSQL is on another host)
PG_SSL=false
PG_SSL_CA_PATH=
# Integration tests use this database (default: <PG_DATABASE>_test). Must end in _test.
# PG_TEST_DATABASE=ad_password_reset_test

# --- JWT ---
JWT_SECRET=replace-with-a-strong-random-string-at-least-64-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- TOTP ---
TOTP_ENCRYPTION_KEY=replace-with-64-char-hex-string-for-aes-256
TOTP_ISSUER=YourCompany Password Reset

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
RATE_LIMIT_GENERAL_MAX=100

# --- Password reset policy ---
# both = security questions AND authenticator (recommended) | totp_only | either
RESET_POLICY=both

# --- Hardening ---
# Optional HTTP port that only redirects to HTTPS (e.g. 80 when PORT=443)
HTTP_REDIRECT_PORT=
# Production refuses a privileged AD_BIND_DN (Domain Admins etc.); set true only as a temporary exception
AD_ALLOW_PRIVILEGED_BIND=false

# Secrets (AD_BIND_PASSWORD, PG_PASSWORD, JWT_SECRET, TOTP_ENCRYPTION_KEY, TLS_PFX_PASSPHRASE)
# can be DPAPI-encrypted: run .\scripts\protect-secret.ps1 (values become dpapi:...)
